---
import Icon from './Icon.astro';
---
<div id="chat-root" transition:persist class="fixed bottom-4 right-4 z-50 sm:bottom-6 sm:right-6">
  <button
    id="chat-open"
    type="button"
    aria-haspopup="dialog"
    aria-controls="chat-panel"
    aria-expanded="false"
    class="inline-flex items-center gap-3 rounded-full bg-primary-strong py-3.5 pl-4 pr-6 text-[15px] font-semibold text-white shadow-pop transition hover:bg-primary-text"
  >
    <span class="inline-flex size-8 items-center justify-center rounded-full bg-white/20"><Icon name="message-circle" size={18} /></span>
    Quelle approche pour moi ?
  </button>

  <section
    id="chat-panel"
    role="dialog"
    aria-label="Chat d'orientation"
    hidden
    class="fixed inset-0 flex flex-col bg-surface sm:absolute sm:inset-auto sm:bottom-0 sm:right-0 sm:h-[640px] sm:max-h-[calc(100vh-3rem)] sm:w-[400px] sm:rounded-2xl sm:border sm:border-line sm:shadow-pop"
  >
    <header class="flex items-center gap-3 border-b border-line px-5 py-4">
      <span class="inline-flex size-10 items-center justify-center rounded-full bg-primary-soft text-primary-text"><Icon name="message-circle" size={18} /></span>
      <div class="flex-1">
        <p class="font-serif text-lg leading-tight">Trouver mon approche</p>
        <p class="text-[13px] text-ink-soft">Aucune donnée personnelle collectée</p>
      </div>
      <button id="chat-close" type="button" class="inline-flex size-9 items-center justify-center rounded-full hover:bg-bg" aria-label="Fermer le chat">
        <Icon name="x" size={20} />
      </button>
    </header>
    <div id="chat-body" class="flex-1 overflow-y-auto px-5 py-5" aria-live="polite"></div>
  </section>
</div>

<script>
  import '../scripts/chat';
</script>
