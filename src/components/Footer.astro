---
import { FOOTER_CABINET, SITE } from "../data/site";
import { APPROCHES } from "../data/approches";
const year = new Date().getFullYear();
---

<footer class="bg-footer">
    <div class="container-x grid gap-12 pb-10 pt-16 md:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1fr_1fr]">
        <div class="flex max-w-sm flex-col gap-5">
            <img
                src="/images/logo.webp"
                alt={`Logo ${SITE.name}`}
                width="149"
                height="34"
                class="h-[34px] w-[149px] self-start"
                loading="lazy"
            />
            <p class="text-[15px] leading-relaxed text-ink-soft">
                {SITE.owner}, thérapeute EMDR, hypnose et TCC à {SITE.city}.
                Thérapies brèves pour enfants, adolescents, adultes, couples et
                familles.
            </p>
            <a
                href="https://www.facebook.com/"
                target="_blank"
                rel="noopener"
                aria-label="Page Facebook"
                class="inline-flex size-10 items-center justify-center rounded-full border border-line bg-surface text-primary-text transition hover:bg-primary-soft"
            >
                <svg
                    viewBox="0 0 24 24"
                    width="18"
                    height="18"
                    fill="currentColor"
                    aria-hidden="true"
                >
                    <path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H8v3h2.5V21h3Z" />
                </svg>
            </a>
        </div>

        <nav aria-label="Approches" class="md:col-span-2 lg:col-span-1">
            <p class="eyebrow mb-4 text-ink">
                <a href="/approches" class="hover:text-primary-text">
                    Approches
                </a>
            </p>
            <ul class="grid grid-cols-1 gap-x-6 gap-y-2.5 text-[15px] sm:grid-cols-2 lg:grid-cols-1">
                {APPROCHES.map((a) => (
                    <li>
                        <a
                            href={`/approches/${a.slug}`}
                            class="hover:text-primary-text"
                        >
                            {a.nav}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>

        <nav aria-label="Le cabinet">
            <p class="eyebrow mb-4 text-ink">Le cabinet</p>
            <ul class="flex flex-col gap-2.5 text-[15px]">
                {FOOTER_CABINET.map((l) => (
                    <li>
                        <a href={l.href} class="hover:text-primary-text">
                            {l.label}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>

        <address class="not-italic">
            <p class="eyebrow mb-4 text-ink">Contact</p>
            <ul class="flex flex-col gap-2.5 text-[15px]">
                <li>{SITE.streetShort}</li>
                <li>
                    {SITE.postalCode} {SITE.city}
                </li>
                <li>
                    <a
                        href={`tel:${SITE.phoneTel}`}
                        class="hover:text-primary-text"
                    >
                        {SITE.phone}
                    </a>
                </li>
                <li>
                    <a
                        href={`mailto:${SITE.email}`}
                        class="break-all hover:text-primary-text"
                    >
                        {SITE.email}
                    </a>
                </li>
            </ul>
        </address>
    </div>

    <div class="container-x flex flex-col gap-3 border-t border-line py-6 text-[13px] text-ink-soft sm:flex-row sm:items-center sm:justify-between">
        <p>
            © {year} {SITE.owner} · {SITE.name}
        </p>
        <ul class="flex gap-6">
            <li>
                <a href="/mentions-legales" class="hover:text-primary-text">
                    Mentions légales
                </a>
            </li>
            <li>
                <a href="/confidentialite" class="hover:text-primary-text">
                    Confidentialité
                </a>
            </li>
            <li>
                <a href="/plan-du-site" class="hover:text-primary-text">
                    Plan du site
                </a>
            </li>
        </ul>
    </div>
</footer>
