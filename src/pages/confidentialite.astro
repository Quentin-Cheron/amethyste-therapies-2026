---
import Layout from "../layouts/Layout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { SITE } from "../data/site";

const crumbs = [{ label: "Accueil", href: "/" }, { label: "Confidentialité" }];
const rights = [
    "Accéder aux données vous concernant",
    "Les faire rectifier",
    "Demander leur effacement",
    "Limiter leur traitement ou vous y opposer",
    "Demander leur portabilité",
];
---

<Layout
    title="Politique de confidentialité | Améthyste Thérapies"
    description="Politique de confidentialité d'Améthyste Thérapies : données collectées, finalités, services tiers, durée de conservation et vos droits."
>
    <section class="container-x pb-16 pt-10 md:pb-24 lg:pt-16">
        <Breadcrumb items={crumbs} />
        <div class="mt-8 max-w-[760px]">
            <h1 data-hero class="text-4xl sm:text-5xl">
                Politique de confidentialité
            </h1>
            <p class="mt-3 text-sm text-ink-soft">
                Dernière mise à jour : 16 octobre 2026
            </p>

            <div class="mt-10 flex flex-col gap-10 text-[17px] leading-relaxed text-ink-soft">
                <section>
                    <h2 class="mb-3 text-2xl text-ink">
                        Responsable du traitement
                    </h2>
                    <p>
                        {SITE.owner}, {SITE.name}, {SITE.street},{" "}
                        {SITE.postalCode} {SITE.city}. Contact :
                        <a
                            href={`mailto:${SITE.email}`}
                            class="text-primary-text hover:underline"
                        >
                            {SITE.email}
                        </a>
                        .
                    </p>
                </section>

                <section>
                    <h2 class="mb-3 text-2xl text-ink">
                        Données collectées et finalités
                    </h2>
                    <ul class="flex flex-col gap-3">
                        <li>
                            <strong class="text-ink">
                                Formulaire de contact.
                            </strong>
                            Nom, téléphone, e-mail, objet de la consultation et
                            message. Ces informations servent uniquement à vous
                            répondre et à vous recontacter. Le message est
                            transmis par e-mail à {SITE.owner} via le service
                            d'envoi Resend, qui agit comme sous-traitant
                            technique. Les messages ne sont pas conservés sur le
                            site lui-même.
                        </li>
                        <li>
                            <strong class="text-ink">
                                Chat d'orientation.
                            </strong>
                            Aucune donnée personnelle n'est collectée. Les
                            symptômes choisis ne sont ni enregistrés ni
                            transmis.
                        </li>
                        <li>
                            <strong class="text-ink">Rendez-vous.</strong>
                            La prise de rendez-vous se fait sur Resalib ou par
                            téléphone. Les données saisies sur Resalib sont
                            gérées par cette plateforme, selon sa propre
                            politique de confidentialité.
                        </li>
                    </ul>
                    <p class="mt-3">
                        Les informations de santé que vous partagez
                        volontairement (message, échanges téléphoniques) sont
                        traitées avec confidentialité et ne sont jamais cédées
                        ni vendues.
                    </p>
                </section>

                <section>
                    <h2 class="mb-3 text-2xl text-ink">Base légale</h2>
                    <p>
                        Votre consentement (formulaire de contact) et l'intérêt
                        légitime de répondre à vos demandes.
                    </p>
                </section>

                <section>
                    <h2 class="mb-3 text-2xl text-ink">Services tiers</h2>
                    <ul class="flex flex-col gap-3">
                        <li>
                            <strong class="text-ink">
                                Polices de caractères
                            </strong>{" "}
                            : elles sont hébergées sur le site lui-même. Aucune
                            donnée n'est transmise à un tiers pour les afficher.
                        </li>
                        <li>
                            <strong class="text-ink">Google Maps</strong> : la
                            carte de la page d'accueil et de la page Contact ne
                            se charge qu'avec votre accord (bouton « J'accepte
                            et j'affiche la carte »). Une fois affichée, Google
                            peut déposer des cookies et recevoir votre adresse
                            IP. Votre choix est mémorisé dans votre navigateur ;
                            vous pouvez l'effacer en supprimant les données du
                            site.
                        </li>
                        <li>
                            <strong class="text-ink">Resalib</strong> : la
                            réservation s'effectue sur le site de cette
                            plateforme.
                        </li>
                    </ul>
                    <p class="mt-3">
                        Le site n'utilise ni outil de mesure d'audience, ni
                        cookie publicitaire.
                    </p>
                </section>

                <section>
                    <h2 class="mb-3 text-2xl text-ink">
                        Durée de conservation
                    </h2>
                    <p>
                        Les messages reçus sont conservés le temps nécessaire
                        pour traiter votre demande, puis supprimés au plus tard
                        trois ans après le dernier contact, sauf obligation
                        légale contraire.
                    </p>
                </section>

                <section>
                    <h2 class="mb-3 text-2xl text-ink">Vos droits</h2>
                    <p>Conformément au RGPD, vous pouvez :</p>
                    <ul class="mt-3 list-disc pl-6">
                        {rights.map((r) => (
                            <li>{r}</li>
                        ))}
                    </ul>
                    <p class="mt-3">
                        Pour exercer ces droits, écrivez à{" "}
                        <a
                            href={`mailto:${SITE.email}`}
                            class="text-primary-text hover:underline"
                        >
                            {SITE.email}
                        </a>
                        . Vous pouvez aussi saisir la CNIL (
                        <a
                            href="https://www.cnil.fr"
                            target="_blank"
                            rel="noopener"
                            class="text-primary-text hover:underline"
                        >
                            cnil.fr
                        </a>
                        ) si vous estimez que vos droits ne sont pas respectés.
                    </p>
                </section>
            </div>
        </div>
    </section>
</Layout>
