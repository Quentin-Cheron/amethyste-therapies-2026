---
import type { GetStaticPaths } from "astro";
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Icon from "../../components/Icon.astro";
import CtaFinal from "../../components/CtaFinal.astro";
import { SITE } from "../../data/site";
import { APPROCHES, getApproche } from "../../data/approches";
import type { Approche } from "../../data/approches";

export const getStaticPaths = (() =>
    APPROCHES.map((a) => ({
        params: { slug: a.slug },
        props: { a },
    }))) satisfies GetStaticPaths;

interface Props {
    a: Approche;
}
const { a: approche } = Astro.props;

const toc = [
    ["definition", approche.what.title],
    ["besoins", approche.needsTitle],
    ["deroulement", "Déroulement d'une séance"],
    ...(approche.extra ?? []).map((e) => [e.id, e.title]),
    ["duree", approche.durationTitle],
    ...(approche.faq ? [["faq", "Questions fréquentes"]] : []),
];
const related = approche.related
    .map((s) => getApproche(s))
    .filter((x): x is Approche => Boolean(x));

const crumbs = [
    { label: "Accueil", href: "/" },
    { label: "Approches", href: "/approches" },
    { label: approche.nav },
];
const ld = [
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
            {
                "@type": "ListItem",
                position: 1,
                name: "Accueil",
                item: SITE.url,
            },
            {
                "@type": "ListItem",
                position: 2,
                name: "Approches",
                item: `${SITE.url}/approches`,
            },
            {
                "@type": "ListItem",
                position: 3,
                name: approche.nav,
                item: `${SITE.url}/approches/${approche.slug}`,
            },
        ],
    },
    ...(approche.faq
        ? [
              {
                  "@context": "https://schema.org",
                  "@type": "FAQPage",
                  mainEntity: approche.faq.map(([q, a]) => ({
                      "@type": "Question",
                      name: q,
                      acceptedAnswer: { "@type": "Answer", text: a },
                  })),
              },
          ]
        : []),
];
---

<Layout
    title={`${approche.h1.join(" ")} | Stéphanie Morier`}
    description={approche.meta}
    jsonLd={ld}
>
    <section class="bg-primary-soft">
        <div class="container-x flex flex-col gap-10 pb-14 pt-8 lg:pb-16">
            <Breadcrumb items={crumbs} />
            <div class="grid items-end gap-10 lg:grid-cols-[1fr_440px] lg:gap-20">
                <div data-hero class="flex flex-col gap-6">
                    <p class="eyebrow text-accent">{approche.fullName}</p>
                    <h1 class="text-4xl leading-[1.1] sm:text-5xl xl:text-[60px]">
                        {approche.h1[0]}
                        <br />
                        {approche.h1[1]}
                    </h1>
                    <p class="max-w-[620px] text-[19px] leading-relaxed text-ink-soft">
                        {approche.lead}
                    </p>
                </div>
                <aside data-reveal class="rounded-xl bg-surface p-7">
                    <dl class="divide-y divide-line">
                        {approche.facts.map(([k, v]) => (
                            <div class="flex justify-between gap-6 py-3 text-[15px]">
                                <dt class="text-ink-soft">{k}</dt>
                                <dd class="text-right font-semibold">{v}</dd>
                            </div>
                        ))}
                    </dl>
                    <a
                        href={SITE.resalib}
                        target="_blank"
                        rel="noopener"
                        class="btn-primary mt-5 w-full"
                    >
                        {approche.cta}
                    </a>
                </aside>
            </div>
        </div>
    </section>

    <section class="container-x section-y grid gap-12 lg:grid-cols-[260px_1fr] lg:gap-20">
        <nav aria-label="Sommaire" class="lg:sticky lg:top-40 lg:self-start">
            <p class="eyebrow mb-4 text-ink-soft">Sur cette page</p>
            <ul class="flex flex-col gap-3 border-l border-line pl-5 text-[15px]">
                {toc.map(([id, label]) => (
                    <li>
                        <a href={`#${id}`} class="hover:text-primary-text">
                            {label}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>

        <article class="flex max-w-[760px] flex-col gap-14">
            <section id="definition" data-reveal class="flex flex-col gap-5">
                <h2 class="text-3xl sm:text-4xl">{approche.what.title}</h2>
                {approche.what.paragraphs.map((p) => (
                    <p class="text-lg leading-relaxed text-ink-soft">{p}</p>
                ))}
                {approche.what.callout && (
                    <p class="rounded-r-xl border-l-4 border-primary bg-primary-soft p-5 text-[15px] leading-relaxed">
                        {approche.what.callout}
                    </p>
                )}
            </section>

            <section id="besoins" class="flex flex-col gap-6">
                <h2 data-reveal class="text-3xl sm:text-4xl">
                    {approche.needsTitle}
                </h2>
                <ul data-stagger class="grid gap-4 sm:grid-cols-2">
                    {approche.needs.map(([t, d]) => (
                        <li class="rounded-xl border border-line bg-surface p-5">
                            <p class="font-serif text-lg">{t}</p>
                            <p class="mt-1 text-sm text-ink-soft">{d}</p>
                        </li>
                    ))}
                </ul>
            </section>

            <section id="deroulement" class="flex flex-col gap-6">
                <h2 data-reveal class="text-3xl sm:text-4xl">
                    Déroulement d'une séance
                </h2>
                <ol data-stagger class="flex flex-col">
                    {approche.steps.map(([t, d], i) => (
                        <li class="flex gap-6 border-t border-line py-6">
                            <span class="font-serif text-3xl text-primary-text">
                                {String(i + 1).padStart(2, "0")}
                            </span>
                            <div>
                                <h3 class="font-sans text-lg font-semibold">
                                    {t}
                                </h3>
                                <p class="mt-1 text-ink-soft">{d}</p>
                            </div>
                        </li>
                    ))}
                </ol>
            </section>

            {approche.extra?.map((e) => (
                <section id={e.id} data-reveal class="flex flex-col gap-5">
                    <h2 class="text-3xl sm:text-4xl">{e.title}</h2>
                    {e.paragraphs.map((p) => (
                        <p class="text-lg leading-relaxed text-ink-soft">{p}</p>
                    ))}
                    {e.callout && (
                        <p class="rounded-r-xl border-l-4 border-primary bg-primary-soft p-5 text-[15px] leading-relaxed">
                            {e.callout}
                        </p>
                    )}
                </section>
            ))}

            <section id="duree" data-reveal class="flex flex-col gap-5">
                <h2 class="text-3xl sm:text-4xl">{approche.durationTitle}</h2>
                <p class="text-lg leading-relaxed text-ink-soft">
                    {approche.duration}
                </p>
                {approche.quote && (
                    <figure class="mt-4 border-l-2 border-primary pl-6">
                        <blockquote class="font-serif text-[1.65rem] leading-snug">
                            « {approche.quote.text} »
                        </blockquote>
                        <figcaption class="mt-3 text-[15px] text-ink-soft">
                            {approche.quote.author}
                        </figcaption>
                    </figure>
                )}
            </section>

            {approche.faq && (
                <section id="faq" class="flex flex-col gap-6">
                    <h2 data-reveal class="text-3xl sm:text-4xl">
                        Questions fréquentes
                    </h2>
                    <div data-faq class="border-t border-line">
                        {approche.faq.map(([q, a]) => (
                            <details class="group border-b border-line">
                                <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden">
                                    <h3 class="font-serif text-xl">{q}</h3>
                                    <span class="inline-flex size-9 shrink-0 items-center justify-center rounded-full bg-bg text-ink transition group-open:bg-primary-strong group-open:text-white">
                                        <Icon
                                            name="plus"
                                            size={18}
                                            class="group-open:hidden"
                                        />
                                        <Icon
                                            name="minus"
                                            size={18}
                                            class="hidden group-open:block"
                                        />
                                    </span>
                                </summary>
                                <div data-faq-panel class="overflow-hidden">
                                    <p class="pb-6 leading-relaxed text-ink-soft">
                                        {a}
                                    </p>
                                </div>
                            </details>
                        ))}
                    </div>
                </section>
            )}
        </article>
    </section>

    <section class="bg-surface" aria-labelledby="liees">
        <div class="container-x section-y flex flex-col gap-10">
            <h2 id="liees" data-reveal class="text-3xl sm:text-4xl">
                Approches complémentaires
            </h2>
            <ul data-stagger class="grid gap-5 md:grid-cols-3">
                {related.map((r) => (
                    <li>
                        <a
                            href={`/approches/${r.slug}`}
                            class="group flex h-full flex-col gap-3 rounded-xl border border-line bg-bg p-7 transition hover:border-primary"
                        >
                            <h3 class="text-[22px]">{r.nav}</h3>
                            <p class="flex-1 text-sm text-ink-soft">
                                {r.summary}
                            </p>
                            <span class="link-arrow text-sm">
                                En savoir plus{" "}
                                <Icon name="arrow-right" size={16} />
                            </span>
                        </a>
                    </li>
                ))}
            </ul>
            <nav
                aria-label="Toutes les approches"
                class="border-t border-line pt-8"
            >
                <p class="eyebrow mb-4 text-ink-soft">Toutes les approches</p>
                <ul class="flex flex-wrap gap-2">
                    {APPROCHES.map((x) => (
                        <li>
                            <a
                                href={`/approches/${x.slug}`}
                                aria-current={
                                    x.slug === approche.slug
                                        ? "page"
                                        : undefined
                                }
                                class="chip transition hover:border-primary hover:bg-primary-soft aria-[current=page]:border-ink aria-[current=page]:bg-ink aria-[current=page]:text-white"
                            >
                                {x.nav}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>
        </div>
    </section>

    <div class="pt-16 md:pt-24">
        <CtaFinal />
    </div>
</Layout>
