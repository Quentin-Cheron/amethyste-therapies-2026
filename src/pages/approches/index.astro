---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import Icon from "../../components/Icon.astro";
import CtaFinal from "../../components/CtaFinal.astro";
import { APPROCHES } from "../../data/approches";
import { SITE } from "../../data/site";

const crumbs = [{ label: "Accueil", href: "/" }, { label: "Approches" }];
const ld = [
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: [
            {
                "@type": "ListItem",
                position: 1,
                name: "Accueil",
                item: SITE.url,
            },
            {
                "@type": "ListItem",
                position: 2,
                name: "Approches",
                item: `${SITE.url}/approches`,
            },
        ],
    },
    {
        "@context": "https://schema.org",
        "@type": "ItemList",
        name: "Approches thérapeutiques proposées au cabinet",
        itemListElement: APPROCHES.map((a, i) => ({
            "@type": "ListItem",
            position: i + 1,
            name: a.nav,
            url: `${SITE.url}/approches/${a.slug}`,
        })),
    },
];
---

<Layout
    title="Approches thérapeutiques à Salon-de-Provence : EMDR, hypnose, TCC | Stéphanie Morier"
    description="EMDR, NMO EMDR+, hypnothérapie, TCC, ICV, EFT, PNL, coaching, sophrologie, approche centrée sur la personne : toutes les approches proposées au cabinet de Salon-de-Provence."
    jsonLd={ld}
>
    <section class="container-x flex flex-col gap-7 pb-12 pt-10 lg:pt-16">
        <Breadcrumb items={crumbs} />
        <div data-hero class="flex flex-col gap-6">
            <h1 class="max-w-[900px] text-4xl sm:text-5xl xl:text-[56px]">
                Mes approches thérapeutiques à Salon-de-Provence
            </h1>
            <p class="max-w-[680px] text-lg leading-relaxed text-ink-soft">
                J'utilise des méthodes humanistes, cognitives et
                comportementales, et je choisis avec vous celle qui vous
                convient. Vous ne savez pas laquelle choisir ?
                <button
                    type="button"
                    data-open-chat
                    class="link-arrow inline text-left underline-offset-4 hover:underline"
                >
                    Trouvez-la en 1 minute
                </button>
                .
            </p>
        </div>
    </section>

    <section
        class="container-x pb-16 md:pb-24"
        aria-label="Liste des approches"
    >
        <ul data-stagger class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {APPROCHES.map((a) => (
                <li>
                    <a
                        href={`/approches/${a.slug}`}
                        class="group flex h-full flex-col gap-3 rounded-xl border border-line bg-surface p-7 transition hover:border-primary"
                    >
                        <p class="eyebrow text-accent">{a.fullName}</p>
                        <h2 class="text-2xl leading-snug">{a.nav}</h2>
                        <p class="flex-1 leading-relaxed text-ink-soft">
                            {a.summary}
                        </p>
                        <span class="link-arrow">
                            En savoir plus <Icon name="arrow-right" size={16} />
                        </span>
                    </a>
                </li>
            ))}
        </ul>
    </section>

    <CtaFinal />
</Layout>
