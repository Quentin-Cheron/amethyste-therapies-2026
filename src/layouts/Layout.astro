---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ChatWidget from "../components/ChatWidget.astro";
import { SITE, jsonLdBase } from "../data/site";

interface Props {
    title: string;
    description: string;
    jsonLd?: object[];
    ogImage?: string;
}
const {
    title,
    description,
    jsonLd = [],
    ogImage = "/images/picture.webp",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const graph = [jsonLdBase(), ...jsonLd];
---

<!doctype html>
<html lang="fr">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <link rel="icon" href="/icon.ico" sizes="any" />
        <meta name="theme-color" content="#fbfaf7" />

        <meta property="og:type" content="website" />
        <meta property="og:locale" content="fr_FR" />
        <meta property="og:site_name" content={SITE.name} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
        <meta name="twitter:card" content="summary_large_image" />

        <ClientRouter />

        {graph.map((d) => (
            <script type="application/ld+json" set:html={JSON.stringify(d)} />
        ))}
    </head>
    <body class="min-h-screen">
        <a
            href="#contenu"
            class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-ink focus:px-4 focus:py-2 focus:text-white"
        >
            Aller au contenu
        </a>
        <Header />
        <main id="contenu">
            <slot />
        </main>
        <Footer />
        <ChatWidget />
        <script>
            import "../scripts/animations";
        </script>
    </body>
</html>
